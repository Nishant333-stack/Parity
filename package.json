{
  "name": "parity",
  "version": "0.1.0",
  "private": true,
  "description": "Marketplace payments platform, reconciled continuously against Stripe's own books",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "synth": "cdk synth",
    "diff": "cdk diff",
    "deploy": "cdk deploy",
    "destroy": "cdk destroy",
    "secret": "bash scripts/set-secret.sh",
    "register-webhook": "bash scripts/register-webhook.sh",
    "verify": "bash scripts/verify-roundtrip.sh",
    "logs": "aws logs tail /aws/lambda/parity-webhook-ingress --follow --profile parity --region ap-south-1"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.700.0",
    "@aws-sdk/client-sqs": "^3.700.0",
    "@aws-sdk/client-ssm": "^3.700.0",
    "@aws-sdk/lib-dynamodb": "^3.700.0",
    "aws-cdk-lib": "^2.170.0",
    "constructs": "^10.4.2",
    "stripe": "^17.5.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.146",
    "@types/node": "^22.10.0",
    "aws-cdk": "^2.170.0",
    "esbuild": "^0.24.0",
    "ts-node": "^10.9.2",
    "typescript": "~5.7.2"
  }
}
